#: src/ui/Advanced.qml:131
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Auto-login does not support unlocking your KDE Wallet automatically, so it "
"will ask you to unlock it every time you log in.<nl/><nl/>To avoid this, you "
"can change the wallet to have a blank password. Note that this is insecure "
"and should only be done in a trusted environment."
msgstr ""
"Automatsko prijavljivanje ne podržava automatsko otključavanje K‑novčanika, "
"pa će tražiti da ga otključate pri svakom prijavljivanju.<nl/><nl/>Da biste "
"to izbjegli, možete novčaniku postaviti praznu lozinku. Imajte na umu da to "
"nije bezbjedno i da treba da se radi samo u pouzdanom okruženju."

#: src/ui/Advanced.qml:136
#, kde-format
msgid "Open KDE Wallet Settings"
msgstr "Otvori postavke K‑novčanika"

#: src/ui/Advanced.qml:142
#, kde-format
msgctxt "@option:check"
msgid "Log in again immediately after logging off"
msgstr "Ponovo se prijavi odmah poslije odjavljivanja"

